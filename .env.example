# Local development uses the dev environment's data and auth (infra/lib/config.ts `data.dev`),
# the same resources PR deploys use. Production's are only ever wired up by the prod web stack.

# SvelteKit public envs used by Amplify config
PUBLIC_AWS_REGION=us-west-1
PUBLIC_COGNITO_USER_POOL_ID=us-west-1_wmKLnq0rh
PUBLIC_COGNITO_USER_POOL_CLIENT_ID=2glrp0sangmaoq65kjltk70qi6
PUBLIC_COGNITO_DOMAIN=pour-decisions-dev.auth.us-west-1.amazoncognito.com
PUBLIC_OAUTH_SCOPES=email,openid,profile
# OAuth redirect/callback URLs are derived from the request origin (see amplifyClient.ts and
# api/auth/github/+server.ts); register each origin with Cognito and the GitHub OAuth app instead.

# Dev-only: prefills the login form on `pnpm dev`. Never applies in production builds
# (guarded by import.meta.env.DEV, which is compiled out of prod bundles).
PUBLIC_DEV_PREFILL_EMAIL=
PUBLIC_DEV_PREFILL_PASSWORD=

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DYNAMODB
DYNAMODB_TABLE=pour-decisions-tastings-dev
DYNAMODB_SETTINGS_TABLE=pour-decisions-user-settings-dev

# GITHUB OAUTH
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=