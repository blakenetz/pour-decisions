# SvelteKit public envs used by Amplify config
PUBLIC_AWS_REGION=
PUBLIC_COGNITO_USER_POOL_ID=
PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
PUBLIC_COGNITO_DOMAIN=
PUBLIC_OAUTH_REDIRECT_SIGNIN=http://localhost:8008/auth/callback
PUBLIC_OAUTH_REDIRECT_SIGNOUT=http://localhost:8008/
PUBLIC_OAUTH_SCOPES=email,openid,profile

# Google Maps Places Autocomplete — used by the "Log a Pour" form's location field
# when the pour happens away from home. Falls back to a plain text field if unset.
# Requires a Google Cloud project with billing enabled and the "Places API (New)"
# enabled: https://console.cloud.google.com/google/maps-apis/api-list
PUBLIC_GOOGLE_MAPS_API_KEY=

# Dev-only: prefills the login form on `pnpm dev`. Never applies in production builds
# (guarded by import.meta.env.DEV, which is compiled out of prod bundles).
PUBLIC_DEV_PREFILL_EMAIL=
PUBLIC_DEV_PREFILL_PASSWORD=

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DYNAMODB
DYNAMODB_TABLE=pour-decisions-tastings

# GITHUB OAUTH
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8008/api/auth/github/callback