{
	"name": "pour-decisions",
	"description": "A palate analytics app for tracking and understanding taste preferences, starting with coffee.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
